// ─────────────────────────────────────────────────────────────────────────────
// Task & Sprint — quản lý tiến độ công việc theo sprint
// ─────────────────────────────────────────────────────────────────────────────

/// Sprint — chu kỳ làm việc ngắn (thường 1–2 tuần)
model Sprint {
  id        String   @id @default(cuid())
  projectId String
  name      String   // e.g. "Sprint 1 — UI Setup"
  goal      String?  // Mục tiêu của sprint
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("sprints")
}

/// Task — đơn vị công việc nhỏ nhất được giao cho thành viên
model Task {
  id          String       @id @default(cuid())
  projectId   String
  sprintId    String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  position    Int          @default(0)  // Thứ tự hiển thị trong cột Kanban
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint    Sprint?  @relation(fields: [sprintId], references: [id])
  assignee  User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy User     @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([projectId, status])   // Kanban board
  @@index([assigneeId])          // Tasks của tôi
  @@index([sprintId])            // Tasks trong sprint
  @@index([dueDate])             // Tasks sắp hết hạn
  @@map("tasks")
}
