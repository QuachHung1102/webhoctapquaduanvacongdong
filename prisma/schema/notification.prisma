// ─────────────────────────────────────────────────────────────────────────────
// Notification — thông báo trong ứng dụng
// ─────────────────────────────────────────────────────────────────────────────

/// Loại thông báo
enum NotificationType {
  APPLICATION_ACCEPTED   // Đơn đăng ký được chấp nhận
  APPLICATION_REJECTED   // Đơn đăng ký bị từ chối
  TASK_ASSIGNED          // Được giao task mới
  TASK_COMPLETED         // Task được đánh dấu hoàn thành
  SPRINT_STARTED         // Sprint mới bắt đầu
  PROJECT_COMPLETED      // Dự án hoàn thành
  REVIEW_RECEIVED        // Nhận được đánh giá
  MEMBER_JOINED          // Thành viên mới tham gia dự án
  MENTION                // Được nhắc đến
}

/// Thông báo gửi đến người dùng
model Notification {
  id        String           @id @default(cuid())
  userId    String           // Người nhận
  type      NotificationType
  title     String
  message   String?
  link      String?          // URL để điều hướng (e.g. /projects/[slug]/tasks)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])    // Thông báo chưa đọc của user
  @@index([userId, createdAt]) // Feed thông báo mới nhất
  @@map("notifications")
}
